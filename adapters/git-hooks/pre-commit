#!/bin/sh
# wiki 仓写入闸(可选):放进知识仓的 .git/hooks/pre-commit 并 chmod +x。
# 对暂存的 .md 跑确定性检查(死链/溯源完整性),不过不让 commit。
# 把下面的路径改成你本机 wiki-manage 的位置。

CLI="$HOME/AI/wiki-manage/plugins/flux-wiki/tools/bin/wiki-cli"
ROOT="$(git rev-parse --show-toplevel)"

python3 "$CLI" --root "$ROOT" lint --staged
status=$?
if [ "$status" -ne 0 ]; then
  echo ""
  echo "❌ wiki 写入校验未过(见上)。处理后重试;确需跳过:git commit --no-verify。"
  exit 1
fi
exit 0
