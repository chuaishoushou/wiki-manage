#!/bin/sh
# 团队 wiki 维护者本机写入闸(放 team-wiki/.git/hooks/pre-commit 并 chmod +x)。
# 校验暂存的 .md frontmatter 闭集 + 敏感度;不过不让 commit。
# 本地、只对写入者生效、不影响只读成员 —— 不是团队级 CI(符合约束 C)。
# 占位符 {{WIKI_MANAGE}} 由 bin/wiki-init 替换;或手动改成你本机 wiki-manage 路径。

CLI="{{WIKI_MANAGE}}/plugins/wiki-governance/tools/bin/wiki-cli"
ROOT="$(git rev-parse --show-toplevel)"

python3 "$CLI" lint --staged --root "$ROOT"
status=$?
if [ "$status" -ne 0 ]; then
  echo ""
  echo "❌ wiki 写入校验未过(见上)。补齐 frontmatter / 处理敏感度后重试。"
  echo "   确需跳过:git commit --no-verify(不建议,会绕过敏感度闸)。"
  exit 1
fi
exit 0
