#!/usr/bin/env python3
"""wiki-init:一键安装(跨平台,纯标准库)。人和 AI 走同一条命令。

做的事(默认就执行,--dry-run 才只预览):
  1. 初始化个人库(幂等:已有则只补缺失,绝不覆盖已有页)
  2. 写机器级配置 ~/.flux-wiki.json(personal_root / team_root / 本仓位置)
  3. 给已安装的 AI 工具写"规则指针"(Claude Code / Codex / Cursor),
     指针块带 begin/end 标记,**重跑整段替换**,真正幂等
  4. Claude Code 额外把 skills + 斜杠命令渲染复制进 ~/.claude/
  5. 自验证:部署物无残留占位符、wiki-cli 可跑、个人库有效;任一不过退出非 0

个人库与团队仓位置**强制必填,缺一不可**(每项独立):
命令行参数 > 已有配置 ~/.flux-wiki.json(即上次安装时用户提供的值)> 终端询问。
终端交互逐项必答(回车只能用方括号里明确显示的默认值,没有"跳过");
非终端(AI/CI)缺任一项**报错退出(rc=2),绝不静默用默认** ——
AI 执行安装时应先向用户询问个人库与团队仓位置,再带参数重跑。

本仓(wiki-manage)就是运行时:装完**不要删除**;更新 = git pull 后重跑本命令。

用法:
  bin/wiki-init                                          # 终端逐项询问(非终端缺参则报错)
  bin/wiki-init --personal-root ~/AI/wiki --team-root ~/AI/team-wiki
  bin/wiki-init --platform cc --dry-run                  # 只预览,不写任何文件
"""
import argparse
import json
import os
import shutil
import subprocess
import sys
from datetime import datetime

# Windows 下输出被重定向/管道捕获时(AI 工具执行即此场景),stdout 编码会回退到
# 本地代码页(如 GBK),打印 ✅/❌ 等字符会直接 UnicodeEncodeError。统一强制 UTF-8。
for _stream in (sys.stdout, sys.stderr):
    if hasattr(_stream, "reconfigure"):
        _stream.reconfigure(encoding="utf-8", errors="replace")

WIKI_MANAGE = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
ADAPTERS = os.path.join(WIKI_MANAGE, "adapters")
PLUGIN = os.path.join(WIKI_MANAGE, "plugins", "flux-wiki")
CLI = os.path.join(PLUGIN, "tools", "bin", "wiki-cli")

CONFIG_PATH = os.path.expanduser("~/.flux-wiki.json")
DEFAULT_PERSONAL = "~/AI/wiki"

MARK_BEGIN = "# === flux-wiki begin (auto by wiki-manage, 重装会整段替换) ==="
MARK_END = "# === flux-wiki end ==="
MARK_LEGACY = "# === flux-wiki (auto by wiki-init) ==="  # 旧版块标记(append-once 时代)

SKILLS = ("wiki-ingest", "wiki-query", "wiki-lint")
COMMANDS = ("wiki-help.md", "wiki-learn.md")
# 旧版本装过、新版已废弃的命令文件(确认是本工具产物才清)
OBSOLETE_COMMANDS = ("wiki-sync.md", "wiki-sync-team.md")


def info(msg):
    print(msg)
    sys.stdout.flush()  # 子进程(wiki-cli)输出穿插时保持顺序


# ---------- 配置与路径解析 ----------

def load_config():
    try:
        with open(CONFIG_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def _abspath(p):
    return os.path.abspath(os.path.expanduser(p))


def _interactive(no_input):
    return (not no_input) and sys.stdin.isatty() and sys.stdout.isatty()


def _ask(title, default):
    """终端交互问一个路径,必答:回车只能用明确显示的默认值,无默认则重问,没有"跳过"。"""
    tail = f"[回车 = {default}] > " if default else "> "
    while True:
        try:
            s = input(f"{title}\n  {tail}").strip()
        except EOFError:
            sys.stderr.write("\n❌ 交互被中断,路径未确认。请带 --personal-root / --team-root 参数重跑。\n")
            sys.exit(2)
        if s:
            return _abspath(s)
        if default:
            return default
        # 必答项:无默认时空回车不放行,重新问


def resolve_paths(args, interactive):
    """返回 (personal, team)。两项强制必填,缺一不可,绝不静默回退到默认值。

    来源优先级(每项独立):命令行参数 > 已有配置(上次安装用户提供的值)> 终端询问。
    非终端(AI/CI)缺任一项 → 报错退出 rc=2。
    """
    cfg = load_config()
    missing = []

    # ① 个人库
    personal = args.personal_root or args.wiki_root
    if personal:
        personal = _abspath(personal)
    else:
        known = cfg.get("personal_root") or os.environ.get("WIKI_ROOT")
        if interactive:
            default = _abspath(known) if known else _abspath(DEFAULT_PERSONAL)
            personal = _ask("① 个人库目录(日常读写的知识库;不存在会自动建)", default)
        elif known:
            personal = _abspath(known)
        else:
            missing.append(f"--personal-root <目录>   个人库(日常读写;不存在会自动建,建议 {DEFAULT_PERSONAL})")

    # ② 团队仓:与个人库同等强制必填
    if args.team_root:
        team = _abspath(args.team_root)
    else:
        known = cfg.get("team_root")
        default = _abspath(known) if known else None
        if interactive:
            team = _ask("② 团队知识仓目录(git clone,只读,供 /wiki-learn 学习)", default)
        elif default:
            team = default
        else:
            team = None
            missing.append("--team-root <目录>       团队知识仓(git clone,只读,供 /wiki-learn 学习)")

    if missing:
        sys.stderr.write("❌ 缺少必需的路径参数(安装强制要求提供个人库与团队仓位置,缺一不可):\n")
        for m in missing:
            sys.stderr.write(f"   {m}\n")
        sys.stderr.write("   AI 执行安装时:请先向用户询问上述位置,再带参数重跑本命令。\n")
        sys.exit(2)

    # 团队仓必须真实存在 —— 绝不把死路径写进指针(本机 team-wiki2 事故的教训)
    while not os.path.isdir(team):
        if interactive:
            info(f"  ⚠ 目录不存在:{team}")
            team = _ask("② 团队知识仓目录(必须是已存在的目录)", None)
        else:
            sys.stderr.write(f"❌ --team-root 指向的目录不存在:{team}\n   修正路径后重跑。\n")
            sys.exit(2)
    return personal, team


# ---------- 渲染 ----------

def render_text(text, personal, team):
    team_line = (f"- **团队知识仓**(git,只读,学习源):`{team}`" if team
                 else "- **团队知识仓**:未配置(需要时重跑 wiki-manage 安装,加 `--team-root <路径>`)")
    return (text.replace("{{WIKI_CLI}}", CLI)
                .replace("{{WIKI_ROOT}}", personal)
                .replace("{{TEAM_ROOT}}", team or "<未配置>")
                .replace("{{TEAM_LINE}}", team_line))


def pointer_body(personal, team):
    with open(os.path.join(ADAPTERS, "pointer-body.md"), "r", encoding="utf-8") as f:
        return render_text(f.read(), personal, team)


def replace_block(path, content, dry_run):
    """把规则文件里的 flux-wiki 块整段替换(没有则追加)。返回动作说明。

    - 新块(begin/end 标记):替换标记之间的内容
    - 旧版块(MARK_LEGACY,无结束标记,当年总是追加在文件末尾):
      先备份原文件,再从旧标记起替换到文件末尾
    """
    block = f"{MARK_BEGIN}\n{content.rstrip()}\n{MARK_END}\n"
    existing = ""
    if os.path.isfile(path):
        with open(path, "r", encoding="utf-8") as f:
            existing = f.read()

    if MARK_BEGIN in existing and MARK_END in existing:
        head, _, rest = existing.partition(MARK_BEGIN)
        _, _, tail = rest.partition(MARK_END)
        new_text = head + block + tail.lstrip("\n")
        action = "更新指针块(整段替换)"
    elif MARK_LEGACY in existing:
        if not dry_run:
            bak = path + ".bak-flux-" + datetime.now().strftime("%Y%m%d%H%M%S")
            shutil.copy2(path, bak)
            info(f"  (旧版指针块已备份到 {bak})")
        head, _, _ = existing.partition(MARK_LEGACY)
        new_text = head.rstrip("\n") + "\n\n" + block
        action = "迁移旧版指针块(已备份原文件)"
    elif existing:
        new_text = existing.rstrip("\n") + "\n\n" + block
        action = "追加指针块"
    else:
        new_text = block
        action = "新建并写入指针块"

    if not dry_run:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            f.write(new_text)
    info(f"  ✅ {action}: {path}")


def _is_ours(path):
    """已存在的 skill/命令是否本工具产物(软链指进本仓,或内容含本工具痕迹)→ 可安全清理。"""
    if os.path.islink(path):
        target = os.path.realpath(path)
        return "wiki-manage" in target or "flux-wiki" in target
    probe = os.path.join(path, "SKILL.md") if os.path.isdir(path) else path
    if not os.path.isfile(probe):
        return os.path.isdir(path) and not os.listdir(path)
    try:
        with open(probe, "r", encoding="utf-8") as f:
            head = f.read(4000)
        return "wiki-cli" in head or "{{WIKI_CLI}}" in head or "LLM Wiki" in head
    except (OSError, UnicodeDecodeError):
        return False


def deploy_rendered(src, dst, label, personal, team, dry_run):
    """渲染复制 skill 目录/命令文件到 AI 工具目录。已存在的本工具旧产物(含软链)先清。"""
    if os.path.lexists(dst):
        if not _is_ours(dst):
            info(f"  ⚠ 跳过 {label}:{dst} 已存在且不是本工具产物,不敢覆盖(请人工确认后删除重装)")
            return
        if not dry_run:
            if os.path.islink(dst) or os.path.isfile(dst):
                os.unlink(dst)
            else:
                shutil.rmtree(dst)
    if dry_run:
        info(f"  · 将安装 {label} → {dst}")
        return
    if os.path.isdir(src):
        shutil.copytree(src, dst, ignore=shutil.ignore_patterns("__pycache__", "*.pyc"))
        for dirpath, _, filenames in os.walk(dst):
            for fn in filenames:
                if fn.endswith(".md"):
                    p = os.path.join(dirpath, fn)
                    with open(p, "r", encoding="utf-8") as f:
                        text = f.read()
                    with open(p, "w", encoding="utf-8") as f:
                        f.write(render_text(text, personal, team))
    else:
        with open(src, "r", encoding="utf-8") as f:
            text = f.read()
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        with open(dst, "w", encoding="utf-8") as f:
            f.write(render_text(text, personal, team))
    info(f"  ✅ 安装 {label}")


# ---------- 平台探测与安装 ----------

def has_claude():
    return os.path.isdir(os.path.expanduser("~/.claude"))


def has_codex():
    return os.path.isdir(os.path.expanduser("~/.codex")) or shutil.which("codex") is not None


def has_cursor():
    candidates = [
        "/Applications/Cursor.app",
        os.path.expanduser("~/.cursor"),
        os.path.expandvars(r"%LOCALAPPDATA%\Programs\cursor"),
    ]
    return any(os.path.isdir(p) for p in candidates) or shutil.which("cursor") is not None


def do_cc(personal, team, dry_run):
    info("\n— Claude Code —")
    replace_block(os.path.expanduser("~/.claude/CLAUDE.md"), pointer_body(personal, team), dry_run)
    sk_dir = os.path.expanduser("~/.claude/skills")
    for s in SKILLS:
        deploy_rendered(os.path.join(PLUGIN, "skills", s), os.path.join(sk_dir, s),
                        f"skill {s}", personal, team, dry_run)
    cmd_dir = os.path.expanduser("~/.claude/commands")
    for c in COMMANDS:
        deploy_rendered(os.path.join(PLUGIN, "commands", c), os.path.join(cmd_dir, c),
                        f"命令 /{c[:-3]}", personal, team, dry_run)
    for c in OBSOLETE_COMMANDS:
        p = os.path.join(cmd_dir, c)
        if os.path.lexists(p) and _is_ours(p):
            if not dry_run:
                os.unlink(p)
            info(f"  ✅ 清理旧版命令 {c}")
    info("  重启 Claude Code 生效")


def do_codex(personal, team, dry_run):
    info("\n— Codex —")
    replace_block(os.path.expanduser("~/.codex/AGENTS.md"), pointer_body(personal, team), dry_run)
    info("  重启 Codex 生效(Codex 无斜杠命令,指针已含等价的 CLI 用法)")


def do_cursor(personal, team, dry_run, project):
    info("\n— Cursor —")
    with open(os.path.join(ADAPTERS, "cursor", "wiki.mdc"), "r", encoding="utf-8") as f:
        rule = render_text(f.read().replace("{{BODY}}", pointer_body(personal, team)), personal, team)
    if project:
        rule_path = os.path.join(_abspath(project), ".cursor", "rules", "wiki.mdc")
        if not dry_run:
            os.makedirs(os.path.dirname(rule_path), exist_ok=True)
            with open(rule_path, "w", encoding="utf-8") as f:
                f.write(rule)
        info(f"  ✅ 写入 {rule_path}(项目级规则)")
        return
    # Cursor 不允许脚本写全局规则 → 打印纯文本供粘贴(去 frontmatter)
    body = rule
    if body.startswith("---"):
        idx = body.find("\n---", 3)
        if idx != -1:
            body = body[body.find("\n", idx + 1) + 1:]
    info("  ⬇ 复制两条分隔线之间的整段,粘进 Cursor:设置 → Rules → User Rules(一次,管所有项目):")
    info("─" * 64)
    info(body.strip())
    info("─" * 64)


# ---------- 个人库初始化 + 自验证 ----------

def init_personal(personal, dry_run):
    if dry_run:
        info(f"  · 将初始化个人库(幂等): {personal}")
        return True
    rc = subprocess.call([sys.executable, CLI, "init", personal])
    return rc == 0


def verify(personal, platforms, dry_run):
    """装完自验证:防"打印一堆 ✅ 但实际装坏"的假成功。"""
    if dry_run:
        return True
    problems = []
    # 1. wiki-cli 能跑且个人库有效
    rc = subprocess.call([sys.executable, CLI, "--root", personal, "status"],
                         stdout=subprocess.DEVNULL)
    if rc != 0:
        problems.append(f"wiki-cli status 失败(个人库 {personal} 无效?)")
    # 2. CC 部署物:存在、非软链、无残留占位符
    if "cc" in platforms:
        for s in SKILLS:
            p = os.path.expanduser(f"~/.claude/skills/{s}/SKILL.md")
            if not os.path.isfile(p):
                problems.append(f"skill 未装上: {p}")
            elif os.path.islink(os.path.dirname(p)):
                problems.append(f"skill 仍是软链(旧版残留): {os.path.dirname(p)}")
            elif "{{" in open(p, encoding="utf-8").read():
                problems.append(f"skill 占位符未渲染: {p}")
        for c in COMMANDS:
            p = os.path.expanduser(f"~/.claude/commands/{c}")
            if not os.path.isfile(p):
                problems.append(f"命令未装上: {p}")
            elif "{{" in open(p, encoding="utf-8").read():
                problems.append(f"命令占位符未渲染: {p}")
        ptr = os.path.expanduser("~/.claude/CLAUDE.md")
        if not (os.path.isfile(ptr) and MARK_BEGIN in open(ptr, encoding="utf-8").read()):
            problems.append(f"指针块未写入: {ptr}")
    if "codex" in platforms:
        ptr = os.path.expanduser("~/.codex/AGENTS.md")
        if not (os.path.isfile(ptr) and MARK_BEGIN in open(ptr, encoding="utf-8").read()):
            problems.append(f"指针块未写入: {ptr}")
    if problems:
        info("\n❌ 自验证未过:")
        for p in problems:
            info(f"   - {p}")
        return False
    info("\n✅ 自验证通过(部署物完整、无残留占位符、个人库有效)")
    return True


# ---------- main ----------

def main():
    p = argparse.ArgumentParser(description="flux-wiki 一键安装(个人库 + 三平台规则指针)")
    p.add_argument("--platform", choices=["cc", "codex", "cursor", "all"], default="all")
    p.add_argument("--personal-root", help=f"个人库目录(强制必填;不存在会自动建,建议 {DEFAULT_PERSONAL})")
    p.add_argument("--team-root", help="团队知识仓目录(强制必填;git clone,只读,必须已存在)")
    p.add_argument("--wiki-root", help="[兼容别名] 等价 --personal-root")
    p.add_argument("--dry-run", action="store_true", help="只预览,不写任何文件")
    p.add_argument("--no-input", action="store_true", help="跳过交互(用参数/配置/默认)")
    p.add_argument("--cursor-project", help="Cursor 项目根(写项目级规则;不给则打印全局 User Rules)")
    args = p.parse_args()
    dry = args.dry_run

    interactive = _interactive(args.no_input)
    personal, team = resolve_paths(args, interactive)

    info(f"\nwiki-manage : {WIKI_MANAGE}(本仓即运行时,请勿删除;更新 = git pull 后重跑安装)")
    info(f"个人库      : {personal}")
    info(f"团队仓      : {team}")
    info(f"模式        : {'仅预览(--dry-run)' if dry else '安装'}")

    # 1. 个人库初始化(先建库,指针永不指向不存在的库)
    info("\n— 个人库 —")
    if not init_personal(personal, dry):
        sys.stderr.write("❌ 个人库初始化失败,中止(指针未写,避免半成品状态)。\n")
        sys.exit(1)

    # 2. 机器级配置
    if not dry:
        cfg = load_config()
        cfg.pop("team_opt_out", None)  # 旧版"显式不配团队仓"记忆已废弃(团队仓现为强制必填)
        cfg.update({"personal_root": personal, "team_root": team,
                    "wiki_manage": WIKI_MANAGE,
                    "installed_at": datetime.now().isoformat(timespec="seconds")})
        with open(CONFIG_PATH, "w", encoding="utf-8") as f:
            json.dump(cfg, f, ensure_ascii=False, indent=2)
            f.write("\n")
        info(f"  ✅ 配置已写入 {CONFIG_PATH}")

    # 3. 平台指针(all = 只配探测到的;显式单平台 = 无条件配)
    auto = args.platform == "all"
    done = []
    if args.platform in ("cc", "all") and (not auto or has_claude()):
        do_cc(personal, team, dry)
        done.append("cc")
    if args.platform in ("codex", "all") and (not auto or has_codex()):
        do_codex(personal, team, dry)
        done.append("codex")
    if args.platform in ("cursor", "all") and (not auto or has_cursor()):
        do_cursor(personal, team, dry, args.cursor_project)
        done.append("cursor")
    if not done:
        info("\n⚠ 未探测到任何 AI 工具(~/.claude / ~/.codex / Cursor),没有写指针。"
             "可用 --platform 显式指定。")

    # 4. 自验证
    ok = verify(personal, done, dry)
    if not dry and ok:
        info(f"\n🎉 安装完成。个人库:{personal};团队仓:{team}(用 /wiki-learn 学习团队知识)")
    sys.exit(0 if ok else 1)


if __name__ == "__main__":
    main()
