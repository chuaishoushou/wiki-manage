#!/usr/bin/env python3
"""wiki-init:团队成员一键 onboarding(跨平台,纯标准库)。

为 Claude Code / Codex / Cursor 写"规则指针",告诉 AI:知识库在哪、规则真源是哪两个文件、
用 wiki-cli(纯 CLI)做 protocol/检索/校验/同步、查知识直接 Read/Grep 库文件。
知识库是本地文件,AI 直接读 + 调 CLI 即可,免去常驻进程与跨平台配置。
CC 额外把 skill + slash 命令链接进 ~/.claude/。默认只打印(安全);--write 才落地。

用法:
  bin/wiki-init                         # 打印三家指针 + 自检
  bin/wiki-init --wiki-root ~/AI/wiki   # 指定 wiki 根
  bin/wiki-init --platform codex --write           # 写 ~/.codex/AGENTS.md 指针
  bin/wiki-init --platform cursor --cursor-project ~/proj --write   # 写 ~/proj/.cursor/rules/wiki.mdc
"""
import argparse
import os
import shutil
import sys

WIKI_MANAGE = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
ADAPTERS = os.path.join(WIKI_MANAGE, "adapters")
CLI = os.path.join(WIKI_MANAGE, "plugins", "wiki-governance", "tools", "bin", "wiki-cli")
MARKER = "# === wiki-governance (auto by wiki-init) ==="


def render(rel_path, wiki_root):
    with open(os.path.join(ADAPTERS, rel_path), "r", encoding="utf-8") as f:
        text = f.read()
    return (text.replace("{{WIKI_MANAGE}}", WIKI_MANAGE)
                .replace("{{WIKI_ROOT}}", wiki_root))


def resolve_wiki_root(arg):
    if arg:
        return os.path.abspath(os.path.expanduser(arg))
    env = os.environ.get("WIKI_ROOT")
    if env:
        return os.path.abspath(os.path.expanduser(env))
    # env 未设时优先约定团队路径,避免兜底到维护者个人库
    team = os.path.expanduser("~/AI/team-wiki")
    if os.path.isdir(team):
        return team
    return os.path.expanduser("~/AI/wiki")


def banner(title):
    print("\n" + "=" * 60)
    print(title)
    print("=" * 60)


def _append_with_marker(path, content):
    """幂等追加:已含 MARKER 则跳过。"""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    existing = ""
    if os.path.isfile(path):
        with open(path, "r", encoding="utf-8") as f:
            existing = f.read()
    if MARKER in existing:
        print(f"  (跳过,已存在 wiki-init 标记) {path}")
        return
    with open(path, "a", encoding="utf-8") as f:
        f.write("\n" + MARKER + "\n" + content + "\n")
    print(f"  ✅ 写入 {path}")


def _link_or_copy(src, dst, label):
    """优先符号链接(git pull 即更新);Windows 无权限/无开发者模式等 OSError 时回退复制。"""
    try:
        os.symlink(src, dst)
        print(f"  ✅ 链接 {label}")
    except OSError:
        if os.path.isdir(src):
            shutil.copytree(src, dst)
        else:
            shutil.copy2(src, dst)
        print(f"  ✅ 复制 {label}(符号链接不可用→已复制;以后 git pull 后需重跑 wiki-init 更新)")


def do_cc(wiki_root, write):
    banner("Claude Code")
    skills_src = os.path.join(WIKI_MANAGE, "plugins", "wiki-governance", "skills")
    cmds_src = os.path.join(WIKI_MANAGE, "plugins", "wiki-governance", "commands")
    ptr = render("cc/CLAUDE.md.pointer", wiki_root)
    if not write:
        print("① 写规则指针到 ~/.claude/CLAUDE.md(告诉 AI:库在哪 / 用 wiki-cli / 直接读库文件):\n")
        print(ptr)
        print("② 装 skill + slash 命令(符号链接,git pull 即更新):")
        print(f"   for s in wiki-ingest wiki-query wiki-lint; do ln -sfn \"{skills_src}/$s\" ~/.claude/skills/$s; done")
        print(f"   mkdir -p ~/.claude/commands; for c in {cmds_src}/wiki-*.md; do ln -sfn \"$c\" ~/.claude/commands/; done")
        print("③ 重启 Claude Code")
        print("(加 --write 自动执行 ①②;或直接走插件市场 /plugin marketplace add chuaishoushou/wiki-manage)")
        return
    _append_with_marker(os.path.expanduser("~/.claude/CLAUDE.md"), ptr)
    sk_dir = os.path.expanduser("~/.claude/skills")
    os.makedirs(sk_dir, exist_ok=True)
    for s in ("wiki-ingest", "wiki-query", "wiki-lint"):
        dst = os.path.join(sk_dir, s)
        if os.path.lexists(dst):
            print(f"  跳过已存在 skill {s}")
        else:
            _link_or_copy(os.path.join(skills_src, s), dst, f"skill {s}")
    cmd_dir = os.path.expanduser("~/.claude/commands")
    os.makedirs(cmd_dir, exist_ok=True)
    for c in os.listdir(cmds_src):
        if not c.endswith(".md"):
            continue
        dst = os.path.join(cmd_dir, c)
        if os.path.lexists(dst):
            print(f"  跳过已存在命令 {c}")
        else:
            _link_or_copy(os.path.join(cmds_src, c), dst, f"命令 {c}")
    print("  重启 Claude Code 生效")


def do_codex(wiki_root, write):
    banner("Codex")
    ptr = render("codex/AGENTS.md.pointer", wiki_root)
    if write:
        _append_with_marker(os.path.expanduser("~/.codex/AGENTS.md"), ptr)
    else:
        print("追加到 ~/.codex/AGENTS.md(用户级指针,跨工作区生效):\n")
        print(ptr)
        print("(加 --write 自动落地)")


def do_cursor(wiki_root, write, project):
    banner("Cursor")
    rule = render("cursor/wiki.mdc", wiki_root)
    if write and project:
        proj = os.path.abspath(os.path.expanduser(project))
        rule_path = os.path.join(proj, ".cursor", "rules", "wiki.mdc")
        os.makedirs(os.path.dirname(rule_path), exist_ok=True)
        with open(rule_path, "w", encoding="utf-8") as f:
            f.write(rule)
        print(f"  ✅ 写入 {rule_path}")
    else:
        print(".cursor/rules/wiki.mdc :\n")
        print(rule)
        print("(加 --write --cursor-project <项目路径> 自动落地;每个项目一次)")


def self_check(wiki_root):
    banner("自检 (wiki-cli protocol)")
    rc = os.system(f'WIKI_ROOT="{wiki_root}" "{sys.executable}" "{CLI}" protocol')
    if rc == 0:
        print("\n✅ 自检通过:能找到 wiki 根、读到协议、工具版本匹配。")
    else:
        print("\n❌ 自检未过:检查 WIKI_ROOT 是否指向 wiki 根(含 AGENTS.md/_vocabulary.md)。")
    return rc == 0


def main():
    p = argparse.ArgumentParser(description="团队 wiki onboarding 生成器(写规则指针)+ 自检")
    p.add_argument("--platform", choices=["cc", "codex", "cursor", "all"], default="all")
    p.add_argument("--wiki-root", help="wiki 根(默认 $WIKI_ROOT 或 ~/AI/team-wiki 或 ~/AI/wiki)")
    p.add_argument("--write", action="store_true", help="真正写入文件(默认只打印)")
    p.add_argument("--cursor-project", help="Cursor 项目根(--platform cursor --write 时需要)")
    args = p.parse_args()

    wiki_root = resolve_wiki_root(args.wiki_root)
    print(f"wiki-manage: {WIKI_MANAGE}")
    print(f"wiki 根    : {wiki_root}")
    print(f"模式       : {'写入' if args.write else '仅打印(加 --write 落地)'}")

    if args.platform in ("cc", "all"):
        do_cc(wiki_root, args.write)
    if args.platform in ("codex", "all"):
        do_codex(wiki_root, args.write)
    if args.platform in ("cursor", "all"):
        do_cursor(wiki_root, args.write, args.cursor_project)

    ok = self_check(wiki_root)
    sys.exit(0 if ok else 1)


if __name__ == "__main__":
    main()
